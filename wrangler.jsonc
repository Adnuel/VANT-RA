{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vant-ra",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "vantera.com.ng/*",
      "zone_name": "vantera.com.ng"
    },
    {
      "pattern": "www.vantera.com.ng/*",
      "zone_name": "vantera.com.ng"
    }
  ]
}
