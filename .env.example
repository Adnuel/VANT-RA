# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Wavy Payment Gateway (wavy.ng)
WAVY_PUBLIC_KEY="wavy_pk_live_your_key_here"
WAVY_SECRET_KEY="wavy_sk_live_your_key_here"
VITE_WAVY_PUBLIC_KEY="wavy_pk_live_your_key_here"

# CJ Dropshipping API 2.0 (Backend Secret Only - Never expose to frontend)
CJ_API_KEY=""

# Transactional Email Delivery for New-Account Verification Codes & Receipts
# Option A: Resend API (https://resend.com)
RESEND_API_KEY=""
# Option B: SMTP (e.g., Gmail App Password: smtp.gmail.com / 465)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="orders@vantera.luxury"

